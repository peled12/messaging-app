generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * TODO: adjust the schema; this is a temp
 */

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String

  @@map("users")
}

model Chat {
  id         String   @id @default(uuid())
  created_at DateTime @default(now())
  chatters   Int[]
  messages   Json

  @@map("chats")
}
